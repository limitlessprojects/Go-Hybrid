# Logs & caches
*.log
.cache/
# NOTE: Cargo.lock and go.sum ARE committed per SPEC.md Phase 5 (reproducible builds)
/
# hyb build outputs (MVP-0 walking-skeleton artifacts)
/build/

# Editor/OS noise
.DS_Store
*.swp
.idea/
.vscode/

# NEVER COMMIT SECRETS (tokens, keys). If a filename here looks like a leak, fix the source.
*.token
*.secret
.env*
jobs/*/result/raw/repo/
jobs/*/result/raw/__*
spikes/*/work/**/target/
spikes/*/work/**/*.a
spikes/*/work/**/bin/
spikes/*/work/**/*.o
spikes/*/work/**/*.test

# Python bytecode
__pycache__/
*.pyc

# the bridge runtime crate builds via CARGO_TARGET_DIR; a crate-local
# target/ (created when env.sh is not sourced) must never land in git
runtime/rust/hyrt/target/
compiler/target/
dist/

